# VOICEVOXエンジンの接続先
VOICEVOX_BASE_URL=http://127.0.0.1:50021
# 読み上げに使う話者ID(VOICEVOXの/speakersで確認できます)
VOICEVOX_SPEAKER_ID=1

# LoL Live Client Data APIの接続先(通常は変更不要)
LIVE_CLIENT_BASE_URL=https://127.0.0.1:2999

# イベントのポーリング間隔(秒)
POLL_INTERVAL_SECONDS=1.0

# Gemini APIキー(https://aistudio.google.com/apikey で無料発行可能)
# 空のままだとLLMによる実況生成は行わずテンプレートの実況文をそのまま使用します
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
