# --- 音声(VOICEVOX) ---
# VOICEVOXエンジンの接続先
VOICEVOX_BASE_URL=http://127.0.0.1:50021
# 読み上げに使う話者ID(VOICEVOXの/speakersで確認できます)
VOICEVOX_SPEAKER_ID=1
# VOICEVOX APIの応答タイムアウト(秒)
VOICEVOX_TIMEOUT_SECONDS=15

# --- LoLクライアント接続 ---
# Live Client Data APIの接続先(通常は変更不要)
LIVE_CLIENT_BASE_URL=https://127.0.0.1:2999
# イベントのポーリング間隔(秒)
POLL_INTERVAL_SECONDS=1.0

# --- AI実況(Gemini) ---
# Gemini APIキー(https://aistudio.google.com/apikey で無料発行可能)
# 空のままだとLLMによる実況生成は行わずテンプレートの実況文をそのまま使用します
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# 実況の最大文字数(音声合成のタイムアウト対策)
MAX_COMMENTARY_LENGTH=60
# Gemini APIの出力トークン上限
GEMINI_MAX_OUTPUT_TOKENS=80
# LLMに渡す直近の実況履歴(試合の経過)の保持件数
COMMENTARY_HISTORY_SIZE=8
# 試合開始時のチーム構成(相性)解説の最大文字数
TEAM_MATCHUP_MAX_LENGTH=150
# チーム構成解説を生成する際のGemini APIの出力トークン上限
TEAM_MATCHUP_MAX_OUTPUT_TOKENS=200

# --- 状況変化の実況しきい値 ---
# CS実況の間隔
CS_MILESTONE_STEP=50
# キル差実況の間隔
KILL_GAP_ALERT_STEP=3
# HP危険域とみなす割合(0.0〜1.0)
LOW_HP_RATIO=0.25
# HP警告を解除する割合(0.0〜1.0)
LOW_HP_RECOVER_RATIO=0.4
